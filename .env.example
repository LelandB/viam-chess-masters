# Copy this file to .env. Never commit the resulting .env file.
MACHINE_ADDRESS=robot12-main.ag9khwy6jn.viam.cloud
API_KEY_ID=
API_KEY=

# Live Viam resource names
ARM_NAME=arm-1
CAMERA_NAME=camera-1
GRIPPER_NAME=gripper-1
DETECTOR_NAME=shape-detector
SEGMENTER_NAME=vision-segment
MOTION_NAME=builtin
HOME_POSE_NAME=home-pose
TABLE_NAME=table
# Exact color, for example rectangle-green or rectangle-blue. Use rectangle-*
# to accept exactly one detected rectangular block of any configured color.
TARGET_LABEL=rectangle-green

# Desired block-center drop pose in the world frame, in millimeters. These
# initial values came from the former place-marker geometry and live detection.
PLACE_X_MM=300
PLACE_Y_MM=150
PLACE_Z_MM=10

# The fixed-threshold color detector can fluctuate under reflections. Retry a
# bounded number of 3D segmentation calls until exactly one target is present.
DETECTION_ATTEMPTS=6
DETECTION_RETRY_DELAY_S=0.5
# RealSense point-cloud segmentation is substantially slower than ordinary RPCs.
DETECTION_TIMEOUT_S=60

# Millimeters. Vision reports the block center, while Motion drives the gripper
# frame. The live claws extend about 54.7 mm below that frame, so 55 mm keeps
# their modeled bottom above the table at pickup and placement.
APPROACH_CLEARANCE_MM=100
GRASP_Z_OFFSET_MM=55
LIFT_CLEARANCE_MM=150
PLACE_Z_OFFSET_MM=55

# Allowed world-frame target and placement area in millimeters.
WORKSPACE_X_MIN_MM=100
WORKSPACE_X_MAX_MM=700
WORKSPACE_Y_MIN_MM=-500
WORKSPACE_Y_MAX_MM=500
WORKSPACE_Z_MIN_MM=-50
WORKSPACE_Z_MAX_MM=500

RPC_TIMEOUT_S=30
SETTLE_S=0.5

# Keep false until the gripper TCP, table, pickup, and placement poses have
# been verified in Viam's 3D Scene and with a supervised low-risk test.
CALIBRATION_APPROVED=false
